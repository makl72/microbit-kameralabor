{"meta":{"cloudId":"pxt/microbit","editor":"blocksprj","name":"Tonprobe - nur Taste A"},"source":"{\"pxt.json\":\"{\\n    \\\"name\\\": \\\"Tonprobe - nur Taste A\\\",\\n    \\\"description\\\": \\\"Taste A spielt ein G.\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\"\\n    ],\\n    \\\"supportedTargets\\\": [\\n        \\\"microbit\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\",\"main.blocks\":\"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"pxt-on-start\\\" x=\\\"450\\\" y=\\\"49\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"pin_set_audio_pin_enabled\\\"><value name=\\\"enabled\\\"><shadow type=\\\"logic_boolean\\\"><field name=\\\"BOOL\\\">FALSE</field></shadow></value></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"460\\\" y=\\\"165\\\"><field name=\\\"NAME\\\">Button.A</field><statement name=\\\"HANDLER\\\"><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.UntilDone</field><value name=\\\"toPlay\\\"><shadow type=\\\"soundExpression_createSoundExpression\\\"><mutation _expanded=\\\"true\\\" _input_init=\\\"8\\\"></mutation><field name=\\\"waveShape\\\">WaveShape.Sine</field><value name=\\\"startFrequency\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">392</field></shadow></value><value name=\\\"endFrequency\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">392</field></shadow></value><value name=\\\"duration\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">500</field></shadow></value><value name=\\\"startVolume\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">160</field></shadow></value><value name=\\\"endVolume\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">160</field></shadow></value><field name=\\\"effect\\\">SoundExpressionEffect.None</field><field name=\\\"interpolation\\\">InterpolationCurve.Linear</field></shadow></value></block></statement></block></xml>\",\"main.ts\":\"pins.setAudioPinEnabled(false)\\ninput.onButtonPressed(Button.A, function () {\\n    music.play(music.createSoundExpression(WaveShape.Sine, 392, 392, 160, 160, 500, SoundExpressionEffect.None, InterpolationCurve.Linear), music.PlaybackMode.UntilDone)\\n})\\n\"}"}
