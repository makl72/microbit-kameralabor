{"meta":{"cloudId":"pxt/microbit","editor":"blocksprj","name":"Teachable Labor - Musiktest"},"source":"{\"pxt.json\":\"{\\n    \\\"name\\\": \\\"Teachable Labor - Musiktest\\\",\\n    \\\"description\\\": \\\"Zahlen 1 bis 5 spielen je einen Ton auf dem eingebauten Lautsprecher des micro:bit V2.\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"teachable-labor\\\": \\\"github:makl72/teachable-labor#2b9500b35f1afa8fb950ba39d14ef7ffe4bb8d33\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\"\\n    ],\\n    \\\"supportedTargets\\\": [\\n        \\\"microbit\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\",\\n    \\\"yotta\\\": {\\n        \\\"config\\\": {\\n            \\\"microbit-dal\\\": {\\n                \\\"bluetooth\\\": {\\n                    \\\"open\\\": 0,\\n                    \\\"whitelist\\\": 1,\\n                    \\\"security_level\\\": \\\"SECURITY_MODE_ENCRYPTION_NO_MITM\\\"\\n                }\\n            }\\n        }\\n    }\\n}\",\"main.blocks\":\"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"teachable_labor_on_1\\\" x=\\\"189\\\" y=\\\"49\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.UntilDone</field><value name=\\\"toPlay\\\"><shadow type=\\\"music_tone_playable\\\"><value name=\\\"note\\\"><shadow type=\\\"device_note\\\"><field name=\\\"name\\\">262</field></shadow></value><value name=\\\"duration\\\"><shadow type=\\\"device_beat\\\"><field name=\\\"fraction\\\">BeatFraction.Whole</field></shadow></value></shadow></value></block></statement></block><block type=\\\"teachable_labor_on_2\\\" x=\\\"183\\\" y=\\\"179\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.UntilDone</field><value name=\\\"toPlay\\\"><shadow type=\\\"music_tone_playable\\\"><value name=\\\"note\\\"><shadow type=\\\"device_note\\\"><field name=\\\"name\\\">392</field></shadow></value><value name=\\\"duration\\\"><shadow type=\\\"device_beat\\\"><field name=\\\"fraction\\\">BeatFraction.Whole</field></shadow></value></shadow></value></block></statement></block><block type=\\\"teachable_labor_on_3\\\" x=\\\"187\\\" y=\\\"323\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.UntilDone</field><value name=\\\"toPlay\\\"><shadow type=\\\"music_tone_playable\\\"><value name=\\\"note\\\"><shadow type=\\\"device_note\\\"><field name=\\\"name\\\">587</field></shadow></value><value name=\\\"duration\\\"><shadow type=\\\"device_beat\\\"><field name=\\\"fraction\\\">BeatFraction.Whole</field></shadow></value></shadow></value></block></statement></block><block type=\\\"teachable_labor_on_4\\\" x=\\\"189\\\" y=\\\"457\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.UntilDone</field><value name=\\\"toPlay\\\"><shadow type=\\\"music_tone_playable\\\"><value name=\\\"note\\\"><shadow type=\\\"device_note\\\"><field name=\\\"name\\\">784</field></shadow></value><value name=\\\"duration\\\"><shadow type=\\\"device_beat\\\"><field name=\\\"fraction\\\">BeatFraction.Whole</field></shadow></value></shadow></value></block></statement></block><block type=\\\"teachable_labor_on_5\\\" x=\\\"198\\\" y=\\\"597\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.UntilDone</field><value name=\\\"toPlay\\\"><shadow type=\\\"music_tone_playable\\\"><value name=\\\"note\\\"><shadow type=\\\"device_note\\\"><field name=\\\"name\\\">175</field></shadow></value><value name=\\\"duration\\\"><shadow type=\\\"device_beat\\\"><field name=\\\"fraction\\\">BeatFraction.Whole</field></shadow></value></shadow></value></block></statement></block><block type=\\\"pxt-on-start\\\" x=\\\"450\\\" y=\\\"49\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"pin_set_audio_pin_enabled\\\"><value name=\\\"enabled\\\"><shadow type=\\\"logic_boolean\\\"><field name=\\\"BOOL\\\">FALSE</field></shadow></value></block></statement></block></xml>\",\"main.ts\":\"pins.setAudioPinEnabled(false)\\nteachableLabor.on3(function () {\\n    music.play(music.tonePlayable(587, music.beat(BeatFraction.Whole)), music.PlaybackMode.UntilDone)\\n})\\nteachableLabor.on4(function () {\\n    music.play(music.tonePlayable(784, music.beat(BeatFraction.Whole)), music.PlaybackMode.UntilDone)\\n})\\nteachableLabor.on2(function () {\\n    music.play(music.tonePlayable(392, music.beat(BeatFraction.Whole)), music.PlaybackMode.UntilDone)\\n})\\nteachableLabor.on5(function () {\\n    music.play(music.tonePlayable(175, music.beat(BeatFraction.Whole)), music.PlaybackMode.UntilDone)\\n})\\nteachableLabor.on1(function () {\\n    music.play(music.tonePlayable(262, music.beat(BeatFraction.Whole)), music.PlaybackMode.UntilDone)\\n})\\n\"}"}